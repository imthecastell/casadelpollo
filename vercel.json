{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/previewv2", "destination": "/", "permanent": false },
    { "source": "/previewv2/(.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/juego", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
